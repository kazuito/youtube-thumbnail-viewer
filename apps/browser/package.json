{
  "name": "browser",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "biome lint",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm biome check --write --unsafe && pnpm typecheck",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitest/ui": "^5.1.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "10.8.0",
    "wxt": "^0.21.5"
  }
}
